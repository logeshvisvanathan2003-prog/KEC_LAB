# Rename this file to .env.local for local development
# Do NOT commit .env.local to GitHub

# Your Render backend URL (for local dev, use localhost)
VITE_API_URL=http://localhost:5000

# ── Set the vars below in Render's dashboard (not here) ──

# Your Neon PostgreSQL connection string (add to Render env vars)
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT secret — change this to a long random string (add to Render env vars)
# JWT_SECRET_KEY=kce-lab-secret-2026-cognentrz

# Agent secret — must match what's in agent/.env on each lab PC (add to Render env vars)
# AGENT_SECRET=kce-agent-key-2026

